PORT=3000
NODE_ENV=development

# ============================================================================
# CONEXIÓN A LAS 2 BASES DE DATOS EN LA NUBE (SUPABASE / RENDER / NEON)
# ============================================================================

# BASE DE DATOS 1: GESTIÓN ACADÉMICA (Estudiante, Tutor, Institución, Tipo, Práctica)
# Ejemplo Supabase: postgres://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?schema=gestion_academica
DATABASE_URL_ACADEMICA=postgresql://usuario:password@host-nube.supabase.co:5432/db_academica

# BASE DE DATOS 2: SEGUIMIENTO DE PRÁCTICAS (Bitácora, Evidencia, Evaluación)
# Ejemplo Supabase: postgres://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?schema=seguimiento_practicas
DATABASE_URL_SEGUIMIENTO=postgresql://usuario:password@host-nube.supabase.co:5432/db_seguimiento
