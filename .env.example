# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DE VARIABLES DE ENTORNO (PROYECTO SIGP UDI)
# Instrucciones: Duplica este archivo como '.env' y completa con tus credenciales.
# NUNCA subas tu archivo '.env' a repositorios públicos de Git / GitHub.
# ==============================================================================

# Puerto de ejecución del servidor local
PORT=3000

# Base de Datos 1: Gestión Académica (Supabase PostgreSQL)
DATABASE_URL_ACADEMICA=postgresql://postgres:[TU_PASSWORD]@[TU_HOST_SUPABASE]:5432/postgres?sslmode=require

# Base de Datos 2: Seguimiento de Prácticas (Supabase PostgreSQL)
DATABASE_URL_SEGUIMIENTO=postgresql://postgres:[TU_PASSWORD]@[TU_HOST_SUPABASE]:5432/postgres?sslmode=require

# Credenciales de API Supabase (si aplica)
SUPABASE_URL=https://[TU_PROYECTO_ID].supabase.co
SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui
